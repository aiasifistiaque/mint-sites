# The backend base URL (render + resolve calls) — SB-04
MINT_API_URL=http://localhost:5021
# HMAC secret shared with the backend for /api/revalidate — SB-04
SITE_REVALIDATE_SECRET=
# Default site addresses <publicSlug>.<root> — SB-14
SITES_ROOT_DOMAIN=
# Comma list of panel origins allowed to drive /__mint/edit — SB-05
PANEL_ORIGINS=http://localhost:3021
# Image hosts optimised by next/image (comma list); others use a plain <img>
MEDIA_HOSTS=
# Set to 1 to serve /__mint/fixture in a production build
MINT_FIXTURES=
